# FindIt4You environment — copy this file to ".env" and fill in your values.
# Get these from your Supabase project: Settings → API.

# Project URL (looks like https://abcdxyz.supabase.co)
SUPABASE_URL=

# anon / public key — safe to expose to the browser (used for signup/login)
SUPABASE_ANON_KEY=

# service_role key — SECRET. Server-only. Full DB access. Never commit or ship to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web server port
PORT=4200
